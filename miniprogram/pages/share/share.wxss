.container{
  padding:40rpx;
  background-color:#f5f5f5;
  min-height:100vh;
}
.title{
  font-size:36rpx;
  font-weight:bold;
  margin-bottom:40rpx;
}
.form-item{
  background:#fff;
  padding:30rpx;
  border-radius:16rpx;
  margin-bottom:20rpx;
}
.label{
  font-size:28rpx;
  margin-bottom:16rpx;
}
.picker,.input{
  font-size:28rpx;
  color:#333;
}
.file-name{
  margin-top:16rpx;
  font-size:26rpx;
  color:#666;
}
.submit-btn{
  margin-top:40rpx;
  background-color:#07c160;
  color:#fff;
}