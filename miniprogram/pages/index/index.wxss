page {
  background-color: #fefbf2;
}

.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.inner {
  width: 100%;
  max-width: 640rpx;
}

/* 欢迎卡片 */
.welcome-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(153, 107, 0, 0.08);
  border: 1rpx solid #fff7e6;
}

.welcome-text {
  font-size: 32rpx;
  color: #666;
}

.name {
  font-size: 38rpx;
  font-weight: bold;
  color: #996b00;
  margin: 8rpx 0 0;
}

/* 通知栏 加宽加高 */
.notice-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  background: #fff7e6;
  border-radius: 12rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}
.notice-left {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}
.notice-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  color: #996b00;
}
.notice-text {
  font-size: 26rpx;
  color: #555;
}
/* 右侧查看详情，颜色区分 */
.notice-detail {
  font-size: 26rpx;
  color: #d63031;
  padding-left: 20rpx;
  white-space: nowrap;
}

/* 功能菜单：上下并排 */
.menu-wrap {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.menu-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 10rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(153, 107, 0, 0.08);
}

.icon {
  font-size: 52rpx;
  margin-bottom: 16rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
}

/* 退出登录 */
.logout-btn {
  margin-top: 60rpx;
  text-align: center;
  font-size: 30rpx;
  color: #996b00;
}