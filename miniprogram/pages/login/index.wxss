.container {
  padding: 120rpx 40rpx 100rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.main-title {
  text-align: center;
  font-size: 52rpx;
  font-weight: bold;
  color: #996b00;
  margin-bottom: 20rpx;
}

.book-icon-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}
.book-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff7cc, #ffe9a8);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(242, 188, 64, 0.25);
}
.book-text {
  font-size: 56rpx;
}
.book-line {
  width: 80rpx;
  height: 6rpx;
  background: #f2bc40;
  border-radius: 6rpx;
  margin-top: 16rpx;
  opacity: 0.6;
}

/* 标题 + 切换文字横向居中 */
.title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
}
.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #444;
}
.switch-text {
  font-size: 32rpx;
  color: #996b00;
  padding: 6rpx 16rpx;
  background: #fff7cc;
  border-radius: 8rpx;
}

.input-box {
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 30rpx;
}
input {
  font-size: 32rpx;
}

.login-btn {
  margin-top: 20rpx;
  background-color: #f2bc40;
  color: #fff;
  border-radius: 12rpx;
}

/* 遮罩层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}
/* 底部弹窗 */
.popup {
  width: 100%;
  background: #fff;
  border-radius: 20rpx 20rpx 0 0;
  overflow: hidden;
}
.role-item {
  text-align: center;
  padding: 32rpx;
  font-size: 32rpx;
  border-bottom: 1rpx solid #eee;
}
.role-item.active {
  color: #996b00;
  background: #fff7cc;
}
.cancel-btn {
  text-align: center;
  padding: 32rpx;
  font-size: 32rpx;
  color: #666;
  margin-top: 12rpx;
  background: #f7f7f7;
}